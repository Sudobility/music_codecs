{
  "name": "@sudobility/music_codecs",
  "version": "0.2.62",
  "description": "Score encoders and decoders for ScoreSmith - MIDI, MusicXML and tracker modules. Shared by frontend and backend; no UI, no audio, no platform.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js",
      "default": "./dist/fixtures.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.esm.json",
    "clean": "rimraf dist",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "verify": "bun run format:check && bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run clean && bun run verify"
  },
  "files": [
    "dist/**/*",
    "CLAUDE.md"
  ],
  "keywords": [
    "typescript",
    "music",
    "midi",
    "musicxml",
    "tracker",
    "scoresmith",
    "codec"
  ],
  "author": "Sudobility",
  "license": "BUSL-1.1",
  "peerDependencies": {
    "@sudobility/music_types": "^0.13.60"
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@sudobility/music_types": "^0.13.60",
    "@sudobility/types": "^1.9.78",
    "@tonejs/midi": "~2.0.28",
    "@types/jsdom": "~30.0.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "globals": "~16.5.0",
    "jsdom": "~25.0.1",
    "prettier": "~3.9.10",
    "rimraf": "~6.1.3",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/music_codecs.git"
  }
}
